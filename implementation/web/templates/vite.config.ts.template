import { defineConfig } from "vite";
import { cpSync, mkdirSync, readdirSync } from "node:fs";
import { fileURLToPath } from "node:url";

// Relative asset paths so the build works wherever the store serves it.
// The desktop mode drops the installable-web files (service worker, manifest) and writes dist-desktop.
const webOnly = ["sw.js", "manifest.webmanifest"];

export default defineConfig(({ mode }) => {
  const desktop = mode === "desktop" || process.env.VITE_DESKTOP === "1";
  const root = fileURLToPath(new URL(".", import.meta.url));
  return {
    base: "./",
    server: { fs: { allow: [fileURLToPath(new URL("..", import.meta.url))] } },
    define: {
      "import.meta.env.VITE_DESKTOP": JSON.stringify(desktop ? "1" : "0"),
      "import.meta.env.VITE_APPLICATION_ID": JSON.stringify({{applicationId:json}}),
    },
    publicDir: desktop ? false : "public",
    build: { target: "es2022", outDir: desktop ? "dist-desktop" : "dist" },
    plugins: desktop ? [{
      name: "desktop-assets",
      transformIndexHtml: { order: "pre", handler: (html: string) => html.replace(/\s*<link rel="manifest"[^>]*>/, "") },
      closeBundle() {
        mkdirSync(`${root}dist-desktop`, { recursive: true });
        for (const entry of readdirSync(`${root}public`)) {
          if (webOnly.includes(entry)) continue;
          cpSync(`${root}public/${entry}`, `${root}dist-desktop/${entry}`, { recursive: true });
        }
      },
    }] : [],
  };
});
