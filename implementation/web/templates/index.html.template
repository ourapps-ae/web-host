<!doctype html>
<html lang="{{language:html}}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="{{themeColour:html}}" />
    <meta name="application-name" content="{{applicationName:html}}" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="{{shortName:html}}" />
    <title>{{applicationName:html}}</title>
    <link rel="icon" href="{{icon512:html}}" type="image/png" />
    <link rel="apple-touch-icon" href="{{icon512:html}}" />
    <link rel="manifest" href="./manifest.webmanifest" />
    <script type="module" src="{{entry:html}}"></script>
  </head>
  <body>
{{body}}
  </body>
</html>
