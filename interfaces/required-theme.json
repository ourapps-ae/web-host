        "schema": {
          "type": "object",
          "properties": {
            "figures": {
              "type": "boolean"
            }
          },
          "required": [
            "figures"
          ],
          "description": "The running background."
        }
      },
      "tags": [
        {
          "name": "web"
        }
      ]
