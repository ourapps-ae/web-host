{
  "openrpc": "1.3.2",
  "info": {
    "title": "ae/theme",
    "version": "1.0.0",
    "description": "Design tokens for colours, spacing, radii, type scale and an animated background, rendered to CSS variables, Swift constants and Kotlin constants. Web: implementation/web/tokens.ts and background.ts. Apple: ThemeTypes.swift, ThemeTokens.swift, BackgroundMath.swift, ThemeBackgroundView.swift. Android: package ae.theme."
  },
  "methods": [
    {
      "name": "validateTokens",
      "description": "Checks a value against the Tokens shape and returns one message per problem; an empty list means valid. Web (tokens.ts) only; Swift and Kotlin hold the generated ThemeTokens constants, which their compilers check.",
      "paramStructure": "by-position",
      "params": [
        {
          "name": "tokens",
          "description": "Any value.",
          "required": true,
          "schema": {}
        }
      ],
      "result": {
        "name": "problems",
        "schema": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "tags": [
        {
          "name": "typescript"
        }
      ]
    },
    {
      "name": "resolveTheme",
      "description": "The named theme with the installer's colour overrides applied; an unknown or missing name gives the file's default theme. Swift: ThemeSet.named(_:) then .resolved(primary:table:), ignoring a malformed colour instead of throwing. Kotlin: ThemeSet.named(name).resolved(primary, table), likewise.",
      "paramStructure": "by-position",
      "params": [
        {
          "name": "file",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/ThemeFile"
          }
        },
        {
          "name": "settings",
          "required": false,
          "schema": {
            "$ref": "#/components/schemas/ThemeSettings"
          }
        }
      ],
      "result": {
        "name": "tokens",
        "schema": {
          "$ref": "#/components/schemas/Tokens"
        }
      },
      "errors": [
        {
          "code": 1,
          "message": "primaryColour is not a colour (write hex rrggbb)"
        },
        {
          "code": 2,
          "message": "tableColour is not a colour (write hex rrggbb)"
        },
        {
          "code": 3,
          "message": "no themes"
        }
      ],
      "tags": [
        {
          "name": "typescript"
        }
      ]
    },
    {
      "name": "themeNames",
      "description": "The theme names in file order. Swift: ThemeTokens.all.keys. Kotlin: ThemeTokens.ALL.keys.",
      "paramStructure": "by-position",
