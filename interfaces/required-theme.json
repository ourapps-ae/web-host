  "components": {
    "schemas": {
      "Colour": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
        "description": "#rrggbb or #rrggbbaa (opacity in the last two digits)."
      },
      "OpaqueColour": {
        "type": "string",
        "pattern": "^#[0-9a-f]{6}$",
        "description": "#rrggbb in lower case, opacity dropped."
      },
      "ColourSetting": {
        "type": "string",
        "pattern": "^\\s*([hH][eE][xX]\\s+)?#?[0-9a-fA-F]{6}([0-9a-fA-F]{2})?\\s*$",
        "description": "An installer colour: 'hex rrggbb' or 'hex rrggbbaa' (an aepm string setting cannot hold '#' and starts with a letter); '#rrggbb' and 'rrggbb' are accepted too."
      },
      "ColourName": {
        "type": "string",
        "enum": [
          "background",
          "surface",
          "edge",
          "primary",
          "onPrimary",
          "table",
          "tableEdge",
          "text",
          "muted",
          "danger",
          "good",
          "warning",
          "paper",
          "paperAccent"
        ]
      },
      "Size": {
        "type": "number",
        "minimum": 0,
        "description": "Points (CSS pixels on the web)."
      },
      "Tokens": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "colour",
          "spacing",
          "radii",
          "type",
          "background"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "colour": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "background",
              "surface",
              "edge",
              "primary",
              "onPrimary",
              "table",
              "tableEdge",
              "text",
              "muted",
              "danger",
              "good",
              "warning",
              "paper",
              "paperAccent"
            ],
            "properties": {
              "background": {
                "$ref": "#/components/schemas/Colour"
              },
              "surface": {
                "$ref": "#/components/schemas/Colour"
              },
              "edge": {
                "$ref": "#/components/schemas/Colour"
              },
              "primary": {
                "$ref": "#/components/schemas/Colour"
              },
              "onPrimary": {
                "$ref": "#/components/schemas/Colour"
              },
              "table": {
                "$ref": "#/components/schemas/Colour"
              },
              "tableEdge": {
                "$ref": "#/components/schemas/Colour"
              },
              "text": {
                "$ref": "#/components/schemas/Colour"
              },
              "muted": {
                "$ref": "#/components/schemas/Colour"
              },
              "danger": {
                "$ref": "#/components/schemas/Colour"
              },
              "good": {
                "$ref": "#/components/schemas/Colour"
              },
              "warning": {
                "$ref": "#/components/schemas/Colour"
              },
              "paper": {
                "$ref": "#/components/schemas/Colour"
              },
              "paperAccent": {
                "$ref": "#/components/schemas/Colour"
              }
            }
          },
          "spacing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "xs",
              "sm",
              "md",
              "lg",
              "xl"
            ],
            "properties": {
              "xs": {
                "$ref": "#/components/schemas/Size"
              },
              "sm": {
