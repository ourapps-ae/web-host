{
  "id": "ourapps-ae.web-host",
  "name": "Web host",
  "kind": "component",
  "status": "example",
  "package": "ourapps-ae/web-host",
  "version": "0.4.1",
  "ports": [
    {
      "id": "theme",
      "name": "Theme",
      "direction": "input",
      "kind": "interface",
      "type": "ae/theme",
      "version": "1.0.0",
      "required": true,
      "cardinality": "one"
    },
    {
      "id": "web-shell",
      "name": "Web shell",
      "direction": "output",
      "kind": "interface",
      "type": "ae/web-shell",
      "version": "1.0.0"
    }
  ],
  "settings": [
    {
      "id": "applicationId",
      "name": "Applicationid",
      "type": "string",
      "required": true,
      "secret": false
    },
    {
      "id": "applicationName",
      "name": "Applicationname",
      "type": "string",
      "required": true,
      "secret": false
    },
    {
      "id": "shortName",
      "name": "Shortname",
      "type": "string",
      "required": true,
      "secret": false
    },
    {
      "id": "themeColour",
      "name": "Themecolour",
      "type": "string",
      "required": true,
      "secret": false
    },
    {
      "id": "backgroundColour",
      "name": "Backgroundcolour",
      "type": "string",
      "required": true,
      "secret": false
    },
    {
      "id": "iconPath",
      "name": "Iconpath",
      "type": "string",
      "required": false,
      "secret": false,
      "default": "icon"
    },
    {
      "id": "webAddress",
      "name": "Webaddress",
      "type": "string",
      "required": true,
      "secret": false
    }
  ]
}
